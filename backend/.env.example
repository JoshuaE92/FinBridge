# Required for the AI chatbot (/api/advice)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional — port the backend listens on (defaults to 5001)
# PORT=5001

# Optional — only needed for the standalone /api/translate route.
# The chatbot does NOT need this; Gemini answers directly in the chosen language.
# GOOGLE_TRANSLATE_KEY=your-google-translate-key-here

# Optional — only needed for the /api/user profile route (Firebase Firestore).
# FIREBASE_SA_PATH=./firebase/serviceAccount.json
